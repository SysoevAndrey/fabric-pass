DATABASE_URL=postgresql://localhost:5432/contributor_registry
# At least 32 characters. Generate with: openssl rand -base64 32
SESSION_PASSWORD=
APP_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Shared secrets for the cf-internal contributors registry sync — generate
# with: openssl rand -hex 32
CONTRIBUTORS_EXPORT_SECRET=
CONTRIBUTORS_SYNC_SECRET=
# Optional — see lib/email.ts. With SMTP_HOST unset, a confirmation email is
# logged instead of sent, so local dev works with none of these set.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
