# Lives at /opt/fabric-pass/.env on the droplet — never committed for real.
# Fixed regardless of directory naming, so the webhook's nested `docker
# compose` call always targets the same project as the initial `up -d`.
COMPOSE_PROJECT_NAME=fabric-pass

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate with: openssl rand -hex 32 — also set as this repo's
# DEPLOY_WEBHOOK_SECRET Actions secret; the two must match.
DEPLOY_WEBHOOK_SECRET=

# --- Everything below is the app's own required environment; see
# .env.example at the repo root and README.md#environment-variables ---
APP_URL=https://pass.cfabric.org

# Generate with: openssl rand -base64 32
SESSION_PASSWORD=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
